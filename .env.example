# Copy this file to ".env" and edit it. Docker Compose reads it automatically.

# Database password. Change it before putting the site on a server.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Production, behind Caddy ("docker compose --profile prod up -d"): set to true.
# The app then trusts Caddy's X-Forwarded-* headers (real visitor IPs for login
# rate limiting, and whether a request came in over HTTPS).
TRUST_PROXY=false

# Optional. Cookies are already marked Secure automatically on HTTPS requests.
# Set to true only to force the Secure flag even on plain-HTTP requests.
SECURE_COOKIES=false

# Optional but recommended on a public server: the first-run setup page then asks for
# this value, so a stranger who reaches a fresh server first can't create the admin.
# Remove it from .env (or leave it) once your admin account exists.
SETUP_TOKEN=

# Optional: email a copy of each contact-form message. Without SMTP_HOST and SMTP_FROM the
# messages are still saved in the admin's Messages inbox. Use your email provider's SMTP
# settings (port 587 with STARTTLS). Choose the address that receives the copies in the admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Backups (Admin > Backup). A backup of the site (content and images, never user accounts) is made about once a day
# and the newest BACKUP_KEEP are kept in the "backups" Docker volume; 0 turns scheduled backups off. Set
# BACKUP_PERSONAL=true to put the subscriber list and contact messages in them too (personal data stays on disk
# in old backups until they are pruned). Download copies and keep them somewhere other than this server.
BACKUP_KEEP=7
BACKUP_PERSONAL=false
